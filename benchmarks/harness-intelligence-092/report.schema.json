{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness intelligence 0.9.2 run evidence",
  "type": "object",
  "required": ["schemaVersion", "benchmarkId", "resultType", "sourceSha", "packageHash", "isolatedRoot", "evidenceRoot", "evidenceSource", "runtime", "model", "effort", "startedAt", "endedAt", "steps", "rework", "recovery", "duplicateSideEffects", "estimated", "providerMeasured", "baseline", "independentReview", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmarkId": { "const": "harness-intelligence-092" },
    "resultType": { "enum": ["smoke", "full"] },
    "sourceSha": { "type": "string", "pattern": "^[a-fA-F0-9]{7,64}$" },
    "packageHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "isolatedRoot": { "type": "string", "minLength": 1 },
    "evidenceRoot": { "type": "string", "minLength": 1 },
    "evidenceSource": { "type": "object", "required": ["kind", "root", "capturedAt", "capturedBy"], "properties": { "kind": { "type": "string", "minLength": 1 }, "root": { "type": "string", "minLength": 1 }, "capturedAt": { "type": "string", "minLength": 1 }, "capturedBy": { "type": "string", "minLength": 1 } } },
    "runtime": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "effort": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "minLength": 1 },
    "endedAt": { "type": "string", "minLength": 1 },
    "steps": { "type": "array", "items": { "type": "object", "required": ["command", "status", "startedAt", "endedAt", "source", "evidencePaths"], "properties": { "command": { "type": "string", "minLength": 1 }, "status": { "enum": ["pass", "fail", "not_run", "pending", "skip", "succeeded", "failed", "cancelled"] }, "startedAt": { "type": "string", "minLength": 1 }, "endedAt": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 }, "evidencePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } },
    "rework": { "type": "integer", "minimum": 0 },
    "recovery": { "type": "integer", "minimum": 0 },
    "duplicateSideEffects": { "type": "integer", "minimum": 0 },
    "estimated": { "type": "object" },
    "providerMeasured": { "type": "object" },
    "baseline": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["run", "not_run"] }, "handoffPath": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "conditions": { "type": "string", "minLength": 1 }, "sameFixture": { "type": "boolean" }, "samePermissions": { "type": "boolean" }, "runtime": { "type": "string" }, "model": { "type": "string" }, "effort": { "type": "string" } } },
    "independentReview": { "type": "object", "required": ["status", "independent", "executorDistinct", "method", "reviewerId", "reviewedAt", "reportEvidence", "categories"], "properties": { "status": { "enum": ["pass", "pending", "fail"] }, "independent": { "const": true }, "executorDistinct": { "const": true }, "method": { "const": "manual-independent-review" }, "reviewerId": { "type": "string", "minLength": 1 }, "reviewedAt": { "type": "string", "minLength": 1 }, "reportEvidence": { "$ref": "#/$defs/evidenceRef" }, "categories": { "type": "object", "required": ["B1", "B2", "B3", "B4", "B5", "B6"] } } },
    "categories": { "type": "object", "required": ["B1", "B2", "B3", "B4", "B5", "B6"], "properties": { "B1": { "$ref": "#/$defs/b1" }, "B2": { "$ref": "#/$defs/b2" }, "B3": { "$ref": "#/$defs/b3" }, "B4": { "$ref": "#/$defs/b4" }, "B5": { "$ref": "#/$defs/b5" }, "B6": { "$ref": "#/$defs/b6" } } }
  },
  "$defs": {
    "evidenceRef": { "type": "object", "required": ["source", "path", "sha256"], "properties": { "source": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } } },
    "b1": { "type": "object", "required": ["installedRoot", "sentinelPath", "sentinelSha256", "installedArtifactPath", "installedArtifactSha256", "packageArchiveEvidence", "installReceipt", "installLog"], "properties": { "installedRoot": { "type": "string", "minLength": 1 }, "sentinelPath": { "type": "string", "minLength": 1 }, "sentinelSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }, "installedArtifactPath": { "type": "string", "minLength": 1 }, "installedArtifactSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }, "packageArchiveEvidence": { "$ref": "#/$defs/evidenceRef" }, "installReceipt": { "$ref": "#/$defs/evidenceRef" }, "installLog": { "$ref": "#/$defs/evidenceRef" } } },
    "b2": { "type": "object", "required": ["cliPath", "dataPath"], "properties": { "cliPath": { "type": "string", "minLength": 1 }, "dataPath": { "type": "string", "minLength": 1 } } },
     "b3": { "type": "object", "required": ["eventsEvidence", "sideEffectsEvidence", "executionEvidence", "retry", "resultPath", "resultSha256"], "description": "Every request, ACK, failure/cancellation, and RESULT event must join taskId when present plus dispatchId/sessionId/requestId/replyTo/attempt; each attempt has one request, one ACK, and one terminal. The trace contains an independent cancellation dispatch and a separate dispatch with at most one explicit retry in a new session; replay adds no side effect and the retry owns the sole result write.", "properties": { "eventsEvidence": { "$ref": "#/$defs/evidenceRef" }, "sideEffectsEvidence": { "$ref": "#/$defs/evidenceRef" }, "executionEvidence": { "$ref": "#/$defs/evidenceRef" }, "taskId": { "type": "string", "minLength": 1 }, "retry": { "type": "object", "required": ["explicit", "attempt"], "properties": { "explicit": { "const": true }, "dispatchId": { "type": "string", "minLength": 1 }, "attempt": { "type": "integer", "minimum": 2 }, "requestId": { "type": "string", "minLength": 1 }, "sessionId": { "type": "string", "minLength": 1 }, "taskId": { "type": "string", "minLength": 1 } } }, "resultPath": { "type": "string", "minLength": 1 }, "resultSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } } },
     "b4": { "type": "object", "required": ["ruleId", "scope", "traceEvidence", "stateBeforeEvidence", "stateRestoredEvidence", "feedbackEvidence"], "description": "Restore compares the effective target-rule projection and requires an append-only audit prefix; it does not require whole-document byte equality.", "properties": { "ruleId": { "type": "string", "minLength": 1 }, "scope": { "enum": ["project", "task"] }, "traceEvidence": { "$ref": "#/$defs/evidenceRef" }, "stateBeforeEvidence": { "$ref": "#/$defs/evidenceRef" }, "stateRestoredEvidence": { "$ref": "#/$defs/evidenceRef" }, "feedbackEvidence": { "$ref": "#/$defs/evidenceRef" } } },
    "b5": { "type": "object", "required": ["lookupPerformed", "task", "lookupEvidence", "decisionEvidence", "sources"], "properties": { "lookupPerformed": { "const": true }, "task": { "type": "object", "required": ["requiresCsvParsing", "promptEvidence", "csvInputEvidence"], "properties": { "requiresCsvParsing": { "const": true }, "promptEvidence": { "$ref": "#/$defs/evidenceRef" }, "csvInputEvidence": { "$ref": "#/$defs/evidenceRef" } } }, "lookupEvidence": { "$ref": "#/$defs/evidenceRef" }, "decisionEvidence": { "$ref": "#/$defs/evidenceRef" }, "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["url", "version", "license", "decision", "decisionReason", "recheckTrigger", "captureEvidence"], "properties": { "url": { "type": "string", "format": "uri" }, "version": { "type": "string", "minLength": 1 }, "license": { "type": "string", "minLength": 1 }, "decision": { "enum": ["adopt", "adapt", "reject"] }, "decisionReason": { "type": "string", "minLength": 1 }, "recheckTrigger": { "type": "string", "minLength": 1 }, "captureEvidence": { "$ref": "#/$defs/evidenceRef" } } } } } },
     "b6": { "type": "object", "required": ["backendEvidence", "uiEvidence", "canonicalStateEvidence", "screenshotEvidence"], "description": "The screenshot evidence must be a genuinely decodable PNG. JPEG/WebP are unsupported/pending in this lightweight scorer and cannot pass marker inspection; PNG validity never establishes browser truth, which remains an independent browser-trace/manual-review duty.", "properties": { "backendEvidence": { "$ref": "#/$defs/evidenceRef" }, "uiEvidence": { "$ref": "#/$defs/evidenceRef" }, "canonicalStateEvidence": { "$ref": "#/$defs/evidenceRef" }, "screenshotEvidence": { "$ref": "#/$defs/evidenceRef" } } }
  }
}
